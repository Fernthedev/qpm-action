# Azurite's public, well-known development storage key (devstoreaccount1).
# It is bundled into dist/ from @azure/storage-blob, used by @actions/cache. Not a real secret.
azure-storage-account-key

# minimatch 10 is required by @actions/glob's matchOne API.
# CVE-2026-118764 requires optimizationLevel >= 2 during pattern preprocessing.
# @actions/glob 0.7.0 does not set this option, so minimatch uses level 1;
# qpm-action supplies cache-directory paths and does not override matcher options.
# Reassess if those options change; remove when Actions glob supports minimatch 11.
# https://github.com/isaacs/minimatch/security/advisories/GHSA-g3hv-75wg-m249
CVE-2026-118764
